local TweenService         = game:GetService("TweenService")
local CoreGui              = game:GetService("CoreGui")
local ContextActionService = game:GetService("ContextActionService")
local StarterGui           = game:GetService("StarterGui")
local LP                   = Players.LocalPlayer

-- ===== CONFIG =====
local REASON = "Exploiting / Use of Unauthorized Third-Party Software"
local DELAY  = 0

-- ===== ID GENERATOR =====
local function randHex(n)
    local t = {}
    for i = 1, n do
        t[i] = string.format("%X", math.random(0, 15))
    end
    return table.concat(t)
end

local function genID()
    return randHex(2).."-"..randHex(2).."-"..randHex(2).."-"..randHex(2).."-"..randHex(8)
end

local BAN_ID   = genID()
local BAN_DATE = os.date("%m/%d/%Y %I:%M %p")

