local gui, bg, content, reasonFrame = build()

-- ===== FADE IN =====
local function fadeIn()
    TweenService:Create(
        bg,
        TweenInfo.new(0.3, Enum.EasingStyle.Linear),
        {BackgroundTransparency = 0}
    ):Play()

    task.delay(0.15, function()
        local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(reasonFrame, info, {BackgroundTransparency = 0}):Play()
        for _, d in ipairs(content:GetDescendants()) do
            if d:IsA("TextLabel") then
                TweenService:Create(d, info, {TextTransparency = 0}):Play()
            end
        end
    end)
end

-- ===== INPUT BLOCK =====
local function blockInput()
    UserInputService.MouseIconEnabled = false
    local sink = function() return Enum.ContextActionResult.Sink end
    for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
        if k ~= Enum.KeyCode.F9 then
            pcall(function()
                ContextActionService:BindAction("P_ban_" .. k.Name, sink, false, k)
            end)
        end
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    end)
end

local function hideTopbar()
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
    end)
end

-- ===== ESCAPE HATCH =====
_G.P_banRemove = function()
    gui:Destroy()
    UserInputService.MouseIconEnabled = true
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
    end)
end

-- ===== RUN =====
task.delay(DELAY, function()
    hideTopbar()
    blockInput()
    fadeIn()
end)

print("[P] fake ban loaded. F9 -> _G.P_banRemove() to dismiss.")
